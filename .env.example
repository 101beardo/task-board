# Postgres connection string. Local dev uses the Docker container from
# docker-compose.yml. In production point this at a hosted Postgres (e.g. Neon:
# postgresql://user:pass@ep-xxx.region.aws.neon.tech/taskboard?sslmode=require).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/taskboard?schema=public"

# Auth: generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
